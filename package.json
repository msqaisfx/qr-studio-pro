{
  "name": "qr-studio-pro",
  "private": true,
  "version": "0.9.6-beta.1",
  "description": "Professional local-first open-source QR code designer",
  "license": "MIT",
  "homepage": "https://msqaisfx.github.io/qr-studio-pro/",
