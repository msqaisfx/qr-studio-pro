    "verify:phase05": "node scripts/verify-phase05.mjs",
    "verify:phase06": "node scripts/verify-phase06.mjs",
    "verify:phase07": "node scripts/verify-phase07.mjs",
    "verify:phase08": "node scripts/verify-phase08.mjs",
    "verify:phase09": "node scripts/verify-phase09.mjs",
    "verify:phase10": "node scripts/verify-phase10.mjs",
    "verify:phase11": "node scripts/verify-phase11.mjs",
    "verify:logo-v3": "node scripts/verify-smart-logo-v3.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@zxing/browser": "0.2.1",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qr-code-styling": "1.9.2",
    "react": "19.3.1",
